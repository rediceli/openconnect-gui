<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Wthink</vendor>
  <vendor_url>https://example.invalid/oc-gui</vendor_url>
  <icon_name>network-vpn</icon_name>

  <!--
    ============================================================
    授权模型的核心约束：按【调用方身份】授权，绝不按【命令行】授权
    ============================================================

    绝对不要写成下面这样（allow_arg openconnect）：

        <allow_any>
          <allow_command>pkexec</allow_command>
          <allow_arg>openconnect</allow_arg>
        </allow_any>

    那等于对全机所有用户开放了「以 root 运行 openconnect」。
    而 openconnect 支持若干「执行任意程序」的开关（csd-wrapper、
    external-browser、script），任何用户都能构造：

        pkexec openconnect &lt;任意脚本执行开关&gt;=/tmp/evil.sh vpn.corp.com

    这是一个无需提权提示的 root 漏洞。

    本文件的 rule 只做一件事：授权「请求启动 oc-gui-helper 这个
    程序」。helper 启动后还会：
      1. 按 uid 校验每个 socket 连接（ipc::authz::authorize）
      2. 按 uid 决定 socket 路径与属主（per_user_socket_path）
      3. 复检 argv，只允许执行 openconnect
    三层防护缺一不可。
  -->

  <action id="org.github.rediceli.ocgui-helper">

    <description>Start the OC GUI privileged helper</description>
    <description xml:lang="zh_CN">启动 OC GUI 特权助手</description>

    <message>Authentication is required to manage network settings (VPN)</message>
    <message xml:lang="zh_CN">需要认证才能管理网络设置（VPN）</message>

    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- 活跃的本地会话中已通过认证的用户：仍需一次确认。
           绝不能用 auth_admin_keep —— 那会在缓存期内无条件放行，
           等于把 root 能力借给一个可能已被攻破的 GUI 进程。 -->
      <allow_active>auth_admin</allow_active>
    </defaults>

    <!--
      annotate_auth_admin = true 会让 polkit 在密码框里显示
      「该程序需要管理网络设置」，减少用户困惑。
    -->
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/oc-gui-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>

  </action>

  <!--
    GUI 侧辅助 action：仅用于「查询 helper 是否可用」这类只读检查。
    单独拆开是为了让这类检查可以用 auth_admin_keep 而不影响启动路径。
  -->
  <action id="org.github.rediceli.ocgui-helper.probe">
    <description>Check whether the OC GUI helper is available</description>
    <description xml:lang="zh_CN">检查 OC GUI 特权助手是否可用</description>
    <message>Authentication is required to check VPN helper status</message>
    <message xml:lang="zh_CN">需要认证才能检查 VPN 助手状态</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

</policyconfig>