# Rust
/src-tauri/target
/src-tauri/helper/target
target/

# 前端
node_modules
# 注意：dist/ 是前端【源码】而非构建产物（无构建链，直接由 Tauri 加载），
# 必须入库。不要在这里忽略它。

# 系统
.DS_Store

# 绝不提交的本地凭据 —— 钥匙串只保存已保存的密码明文，
# profile 文件里只有 password_saved 标记，不含任何密钥。
/account.txt
*.account
secrets.env

# Windows 运行时依赖由 ci/fetch-win-deps.sh 生成，不入库
/src-tauri/win-deps/*
!/src-tauri/win-deps/README.md
/src-tauri/.win-build/

# Swift Package Manager（macOS helper）
/src-tauri/macos-helper/.build/
/src-tauri/macos-helper/.swiftpm/

# macOS 公证产物
*.zip
